# Internal database (H2, file-based persistence — infrastructure-design.md)
MM5_INTERNAL_DB_PATH=./data/mastermeister5
MM5_INTERNAL_DB_USERNAME=sa
MM5_INTERNAL_DB_PASSWORD=

# Rate limiting (bucket4j, per IP address — nfr-design-patterns.md)
# MASTERMEISTER5_SECURITY_RATE-LIMIT_CAPACITY=10
# MASTERMEISTER5_SECURITY_RATE-LIMIT_REFILL-TOKENS=10
# MASTERMEISTER5_SECURITY_RATE-LIMIT_REFILL-PERIOD-SECONDS=60

# User management (Unit 2)
# Base URL used to build invitation/password-reset links sent by email.
MM5_APP_BASE_URL=http://localhost:8080
# JWT signing secret (HS256) — REQUIRED, at least 32 bytes (256 bits).
MM5_JWT_SECRET=
# MM5_ACCESS_TOKEN_TTL_MINUTES=10
# MM5_REFRESH_TOKEN_TTL_HOURS=24
# MM5_INVITATION_TOKEN_TTL_HOURS=3
# MM5_PASSWORD_RESET_TOKEN_TTL_HOURS=3
# MM5_MAX_FAILED_LOGIN_ATTEMPTS=5
# MM5_ACCOUNT_LOCK_DURATION_MINUTES=15
# MM5_PASSWORD_MIN_LENGTH=8

# Initial administrator (created once on startup if not already present).
# Leave both blank to skip bootstrap.
MM5_INITIAL_ADMIN_EMAIL=
MM5_INITIAL_ADMIN_PASSWORD=

# SMTP (invitation / password-reset emails). Defaults target the devenv MailPit container.
# MM5_SMTP_HOST=localhost
# MM5_SMTP_PORT=1025
MM5_SMTP_USERNAME=
MM5_SMTP_PASSWORD=
# MM5_SMTP_AUTH=false
# MM5_SMTP_STARTTLS=false
MM5_MAIL_FROM=no-reply@mastermeister5.local

# Target RDBMS connection secrets (Unit 3)
# AES-256-GCM key used to encrypt/decrypt target RDBMS connection passwords —
# REQUIRED, at least 32 bytes (256 bits).
MM5_CONNECTION_SECRET_KEY=
